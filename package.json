{
  "name": "award-voting-system",
  "version": "1.0.0",
  "private": true,
  "description": "Firestore-backed award voting system with an administrator dashboard",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node server.js",
    "build": "vite build",
    "build:mobile": "vite build --mode mobile",
    "cap:sync": "npm run build:mobile && cap sync",
    "initialize-db": "node initialize-db.js",
    "create-admin": "node create-admin.js"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "firebase": "^12.6.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.11"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
